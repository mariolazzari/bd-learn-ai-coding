{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/deepseek-v4.1-flash-free",
  "watcher": {
    "ignore": ["logs/**"]
  },
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 10000
    },
    "buffer": 20000
  },
  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "enabled": true
      },
      "notion": {
        "type": "remote",
        "url": "https://mcp.notion.com/mcp",
        "enabled": true,
        "disabled": true,
        "oauth": {}
      },
      "playwright": {
        "type": "local",
        "command": [
          "bunx",
          "--bun",
          "@playwright/mcp@0.0.83",
          "--isolated"
        ],
        "enabled": true,
        "disabled": true
      },
      "chrome-devtools": {
        "type": "local",
        "command": ["bunx", "--bun", "--isolated", "chrome-devtools-mcp@latest"],
        "enabled": true
      }
    }
  },
  "permissions": [
    {
      "action": "shell",
      "resource": "bootdev run *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "run_slop",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "skill",
      "resource": "create-test-program",
      "effect": "ask"
    },
    {
      "action": "subagent",
      "resource": "explore",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*.env",
      "effect": "deny"
    }
  ]
}
